# BEGIN FINILA
# Managed by scripts/deploy-webglobe.sh, edit it in the repository (deploy/htaccess).
# The old WordPress rules are saved on the server in .htaccess-wordpress-zaloha.
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# One address for the whole site: http and finila.com go to https://www.finila.com (Google indexes one copy).
# Webglobe sets HTTPS=on for secure requests (checked on the live server on 2026-10-21).
RewriteCond %{HTTP_HOST} ^finila\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.finila.com/$1 [R=301,L]

# Smaller downloads: pages, scripts and data files are sent compressed (the big JSON files shrink about 4 times).
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>
# Images and fonts rarely change, so browsers may keep them for a month; pages, scripts and data are checked every visit.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# The old WordPress no longer runs: its PHP, admin and leftover folders are closed.
RewriteRule \.php$ - [F,L]
RewriteRule ^(wp-admin|wp-includes|backup|logs|tmp)(/|$) - [F,L]

# Clean addresses for the FINILA pages: /screener shows screener.html, and the
# old /screener.html and /index.html addresses redirect to /screener and /.
# A new page needs its name added to both lists.
# Pages that moved keep their old address forever as a 301 redirect (query strings carry over).
RewriteRule ^companies(\.html)?$ /screener [R=301,L]
RewriteRule ^invest(\.html)?$ /assets [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(screener|insiders|shorts|assets|rates|property|map|groups)\.html[\s?]
RewriteRule ^(screener|insiders|shorts|assets|rates|property|map|groups)\.html$ /$1 [R=301,L]
RewriteRule ^(screener|insiders|shorts|assets|rates|property|map|groups)$ $1.html [L]

# Company pages: /stock/asml-holding shows stock/asml-holding.html, /stock/ is the A-Z list.
RewriteCond %{THE_REQUEST} \s/+stock/index\.html[\s?]
RewriteRule ^stock/index\.html$ /stock/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+stock/[a-z0-9-]+\.html[\s?]
RewriteRule ^stock/([a-z0-9-]+)\.html$ /stock/$1 [R=301,L]
RewriteRule ^stock/([a-z0-9-]+)$ stock/$1.html [L]
RewriteRule ^stock$ /stock/ [R=301,L]

# Property pages by country: /property/slovakia shows property-pages/slovakia.html. They live in
# their own folder so that /property (property.html) never meets a /property/ directory.
RewriteRule ^property/$ /property [R=301,L]
RewriteRule ^property/overvalued$ /property/undervalued [R=301,L]
RewriteCond %{THE_REQUEST} \s/+property-pages/[a-z0-9-]+\.html[\s?]
RewriteRule ^property-pages/([a-z0-9-]+)\.html$ /property/$1 [R=301,L]
RewriteRule ^property/([a-z0-9-]+)$ property-pages/$1.html [L]

# Market Radar: /radar is built as radar.html, /radar/shiller-cape shows radar-pages/shiller-cape.html.
RewriteCond %{THE_REQUEST} \s/+radar\.html[\s?]
RewriteRule ^radar\.html$ /radar [R=301,L]
RewriteRule ^radar/?$ radar.html [L]
RewriteCond %{THE_REQUEST} \s/+radar-pages/[a-z0-9-]+\.html[\s?]
RewriteRule ^radar-pages/([a-z0-9-]+)\.html$ /radar/$1 [R=301,L]
RewriteRule ^radar/([a-z0-9-]+)$ radar-pages/$1.html [L]

# Links inside the archive point to /archiv/...: send visitors to the original
# address instead (/archiv/blog/index.html -> /blog/). Images, scripts and the
# archive's own home page (/archiv/) stay where they are.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/wp-(content|includes)/
RewriteRule ^archiv/(.+/)(index\.html)?$ /$1 [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^archiv/index\.html$ /archiv/ [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^archiv/([^/]+\.html)$ /$1 [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+/)index\.html$ /$1 [R=301,L]

# Old addresses (e.g. /blog/) keep working and show their copy from /archiv/
# without changing the address in the browser.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+/)$ archiv/$1index.html [L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ archiv/$1/index.html [L]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/archiv/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ archiv/$1 [L]
# END FINILA
